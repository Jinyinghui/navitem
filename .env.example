# 复制为 .env 后填入你的值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密码

PORT=3000
# 部署目录在宿主机上的绝对路径（cd 到部署目录后 pwd 的输出）；给后台「系统更新」用，不用更新功能可不填
HOST_DEPLOY_DIR=
# 后台「系统更新」的共享密钥：填一段随机字符串（如 openssl rand -hex 24），nav-item 与 updater 共用；不填则更新功能禁用
UPDATER_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你的密码
JWT_SECRET=请改成随机字符串
